{
  "name": "contract-bridge-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint .",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage -w packages/game-engine"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "oxlint": "^1.94.0",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "workerd@1.20261110.1": true,
    "workerd@1.20261117.1": true,
    "esbuild@0.28.2": true
  }
}
