/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "contract-bridge-online",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-17",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	/**
	 * D1: identity, sessions, room directory, results. No database_id is committed:
	 * local dev uses a local SQLite file; the real ID is added only when the owner
	 * provisions the remote database (see docs/DEPLOYMENT.md).
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "contract-bridge-db",
			"database_id": "2e9ba037-cab3-4607-a39d-acb5daac273e",
			"migrations_dir": "../../migrations"
		}
	],
	/** One SQLite-backed Durable Object per room: authoritative live game state. */
	"durable_objects": {
		"bindings": [{ "name": "BRIDGE_ROOMS", "class_name": "BridgeRoom" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["BridgeRoom"] }],
	/** Workers Rate Limiting: guest creation per IP, room create/join per user. */
	"ratelimits": [
		{ "name": "GUEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
		{ "name": "ROOM_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
	],
	"vars": {
		/** Comma-separated extra allowed Origins. Same-origin is always allowed. */
		"ALLOWED_ORIGINS": "",
		/** Seconds an empty room (nobody connected) stays open before it is closed. */
		"ROOM_EMPTY_TTL_SECONDS": "900"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}